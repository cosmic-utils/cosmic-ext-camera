# Alpine APK build environment
FROM alpine:edge

RUN apk add --no-cache \
    alpine-sdk sudo git \
    cargo \
    clang-libclang \
    cmake \
    cosmic-icons \
    dav1d-dev \
    eudev-dev \
    glib-dev \
    gst-plugins-bad-dev \
    gst-plugins-base-dev \
    gstreamer-dev \
    just \
    libinput-dev \
    libseat-dev \
    libxkbcommon-dev \
    nasm \
    pkgconf \
    samurai \
    wayland-dev

# Newer abuild writes keys to ~/.config/abuild; older versions use ~/.abuild.
# The trailing ls fails the image build here rather than midway through
# `abuild -r` if neither location produced a key.
RUN adduser -D builder && \
    addgroup builder abuild && \
    echo "builder ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers && \
    sudo -Hu builder abuild-keygen -a -n && \
    for d in /home/builder/.config/abuild /home/builder/.abuild; do \
        [ -d "$d" ] && cp "$d"/*.rsa.pub /etc/apk/keys/ || true; \
    done && \
    ls /etc/apk/keys/*.rsa.pub

# Minimal native SDK APKs; keep the same key used for the Camera package.
COPY docker/build-libcamera-apk.sh /opt/camera/docker/build-libcamera-apk.sh
COPY docker/libcamera/APKBUILD /opt/camera/docker/libcamera/APKBUILD
RUN sh /opt/camera/docker/build-libcamera-apk.sh
